# Core application settings
APP_NAME=InsightHub Intelligence Service
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50

# Future AnythingLLM integration (optional in Phase 0)
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=replace-with-anythingllm-api-key
ANYTHINGLLM_TIMEOUT_SECONDS=30

# Future hosted LLM configuration (optional in Phase 0)
LLM_PROVIDER=replace-with-provider-name
LLM_MODEL=replace-with-model-name
LLM_API_KEY=replace-with-llm-api-key

# Future read-only PostgreSQL connection (optional in Phase 0)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=insighthub
POSTGRES_USER=insighthub_readonly
POSTGRES_PASSWORD=replace-with-postgres-password

# Future Langfuse Cloud observability configuration (optional in Phase 0)
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
