#################################
# Application
#################################

APP_NAME=insighthub
APP_ENV=development
LOG_LEVEL=INFO


#################################
# Intelligence API
#################################

INTELLIGENCE_PORT=8000


#################################
# AnythingLLM
#################################

ANYTHINGLLM_BASE_URL=http://anythingllm:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE_ID=insighthub-demo
ANYTHINGLLM_TIMEOUT_SECONDS=60


#################################
# LLM Provider
#################################

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_TIMEOUT_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_FAILURES=2


#################################
# Embedding Provider
#################################

EMBEDDING_PROVIDER=anythingllm-native
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2


#################################
# PostgreSQL demo database
#################################

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=nova_retail
POSTGRES_USER=nova_retail
POSTGRES_PASSWORD=


#################################
# Analytics
#################################

DUCKDB_PATH=/data/analytics.duckdb


#################################
# Observability
#################################

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=


#################################
# Evaluation
#################################

EVALUATION_DATASET_PATH=evaluation/datasets
AGENT_EVALUATION_DATASET_PATH=evaluation/agent/questions.json
AGENT_EVALUATION_REPORT_PATH=evaluation/agent/reports/latest.json


#################################
# Storage
#################################

DATA_DIR=/data
MAX_UPLOAD_SIZE_MB=100
